<Window x:Class="FastSearch.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:settings="clr-namespace:FastSearch.Settings" Title="FastSearch の設定"
        Icon="/FastSearch;component/Assets/FastSearch.ico" Width="510" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Theme.Background}" Foreground="{DynamicResource Theme.Text}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="配色" FontWeight="SemiBold" Margin="0,0,0,8" />
      <ComboBox x:Name="ThemeBox" SelectedValuePath="Tag" AutomationProperties.Name="配色">
        <ComboBoxItem Content="ライトグレー" Tag="{x:Static settings:AppTheme.LightGray}" />
        <ComboBoxItem Content="チャコール（ダーク）" Tag="{x:Static settings:AppTheme.Charcoal}" />
      </ComboBox>
      <TextBlock Text="保存すると両方の画面に反映し、次回起動時にも使用します。"
                 Foreground="{DynamicResource Theme.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    <TextBlock Grid.Row="1" Text="検索画面を呼び出すショートカット" FontWeight="SemiBold" Margin="0,0,0,8" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="ShortcutBox" IsReadOnly="True" FontSize="17" Padding="10,7"
               AutomationProperties.Name="呼び出しショートカット。キーの組み合わせを押して変更"
               PreviewKeyDown="ShortcutBox_KeyDown" />
      <Button x:Name="ResetShortcutButton" Grid.Column="1" Content="既定に戻す" Margin="10,0,0,0" Padding="12,6" Click="Reset_Click" />
    </Grid>
    <TextBlock Grid.Row="3" Text="欄を選択し、Ctrl・Alt・Winと他のキーを同時に押してください。"
               Foreground="{DynamicResource Theme.Secondary}" TextWrapping="Wrap" Margin="0,8,0,22" />
    <CheckBox Grid.Row="4" x:Name="ResidentBox" Content="ウィンドウを閉じてもトレイに常駐する" />
    <TextBlock Grid.Row="5" Text="オフの場合は ×／Esc で終了し、トレイアイコンは表示しません。"
               Foreground="{DynamicResource Theme.Secondary}" TextWrapping="Wrap" Margin="22,8,0,18" />
    <CheckBox Grid.Row="6" x:Name="StartupBox" Content="Windowsログイン時に起動する" />
    <TextBlock Grid.Row="7" Text="常駐オンならトレイ、オフなら検索画面を表示します。&#10;検索画面を終了しても、索引サービスは更新を続けます。"
               Foreground="{DynamicResource Theme.Secondary}" TextWrapping="Wrap" Margin="22,8,0,16" />
    <Button Grid.Row="8" x:Name="ServiceButton" Content="索引サービスをインストール／更新" Padding="12,7" HorizontalAlignment="Left" Click="Service_Click" />
    <TextBlock Grid.Row="9" Text="初回と更新時だけ管理者権限（UAC）が必要です。&#10;インストール後はWindows起動時にサービスが開始します。"
               Foreground="{DynamicResource Theme.Secondary}" TextWrapping="Wrap" Margin="0,8,0,16" />
    <TextBlock Grid.Row="10" Text="Ctrl + 1〜4 の列ソートなど、画面内の操作キーは従来どおりです。"
               Foreground="{DynamicResource Theme.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBlock Grid.Row="11" x:Name="ErrorText" Foreground="{DynamicResource Theme.Error}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="キャンセル" IsCancel="True" Padding="18,7" Margin="0,0,10,0" />
      <Button x:Name="SaveButton" Content="保存" IsDefault="True" Padding="24,7" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
