<Window x:Class="FastSearch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FastSearch" Icon="/FastSearch;component/Assets/FastSearch.ico" Width="1120" Height="720"
        MinWidth="640" MinHeight="360" WindowStartupLocation="CenterScreen" Background="{DynamicResource Theme.Background}"
        Foreground="{DynamicResource Theme.Text}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="7" Padding="13,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" FontSize="23" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,12,0" VerticalAlignment="Center" />
        <Grid Grid.Column="1">
          <TextBox x:Name="SearchBox" AutomationProperties.Name="ファイル名・フォルダ階層を検索" BorderThickness="0"
                   Background="Transparent" Foreground="{DynamicResource Theme.Text}" FontSize="18" VerticalContentAlignment="Center"
                   TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_KeyDown" Padding="0" />
          <TextBlock Text="ファイル名・フォルダ階層を検索" FontSize="18" Foreground="{DynamicResource Theme.Secondary}" IsHitTestVisible="False" VerticalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <Button x:Name="SettingsButton" Grid.Column="2" Content="設定" AutomationProperties.Name="FastSearch の設定を開く"
                Padding="12,5" Margin="12,0,0,0" VerticalAlignment="Center" Click="Settings_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="7">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DataGrid x:Name="Results" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow"
                  RowHeight="32" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None" Background="{DynamicResource Theme.Surface}"
                  RowBackground="{DynamicResource Theme.Surface}" Foreground="{DynamicResource Theme.Text}" AlternatingRowBackground="{DynamicResource Theme.Alternate}" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  InputMethod.IsInputMethodEnabled="False"
                  ScrollViewer.CanContentScroll="True" Sorting="Results_Sorting"
                  PreviewKeyDown="Results_KeyDown" PreviewTextInput="Results_TextInput" PreviewMouseRightButtonUp="Results_RightClick"
                  PreviewMouseLeftButtonDown="Results_MouseDown" PreviewMouseLeftButtonUp="Results_MouseUp" PreviewMouseMove="Results_MouseMove">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers><Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Theme.Selection}" /><Setter Property="Foreground" Value="{DynamicResource Theme.SelectedText}" />
              </Trigger></Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="名前" Binding="{Binding Name}" SortMemberPath="Name" Width="260" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="フォルダ" Binding="{Binding Folder}" SortMemberPath="Folder" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" SortMemberPath="Size" Width="110">
              <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="TextAlignment" Value="Right" /></Style></DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="更新日時" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="180" ElementStyle="{StaticResource CellText}" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyHint" Text="検索する名前を入力してください" Foreground="{DynamicResource Theme.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600" Margin="24" />
        <Border Grid.Row="1" Background="{DynamicResource Theme.Background}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="10,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="IndexStatus" Text="索引を準備しています…" Foreground="{DynamicResource Theme.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock x:Name="ResultStatus" Grid.Column="1" Text="0 件" Foreground="{DynamicResource Theme.Accent}" Margin="15,0,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
